{
  "name": "@yoast/ui-library",
  "version": "4.7.0",
  "description": "Yoast UI library",
  "main": "build/index.js",
  "style": "build/css/style.css",
  "files": [
    "build",
    "!*.map"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Yoast/wordpress-seo.git",
    "directory": "packages/ui-library"
  },
  "author": "Team Yoast <support@yoast.com>",
  "license": "GPL-3.0",
  "private": false,
  "sideEffects": false,
  "scripts": {
    "build": "yarn clean:build && yarn build:js && yarn build:css",
    "build:js": "babel src --out-dir build --ignore \"src/**/*.stories.js\",\"src/**/stories.js\",\"src/**/docs/**/*.js\"",
    "build:css": "node ./scripts/build-css.js",
    "clean:build": "rm -rf build",
    "watch": "yarn clean:build && ( yarn watch:js & yarn watch:css )",
    "watch:js": "yarn build:js --watch",
    "watch:css": "node ./scripts/watch-css.js",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "publish:storybook": "./scripts/publish-storybook.sh",
    "test": "jest",
    "lint": "eslint . --max-warnings=2"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.9",
    "@babel/core": "^7.23.9",
    "@babel/parser": "^7.23.9",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-transform-runtime": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-react": "^7.23.3",
    "@storybook/addon-a11y": "^8.6.12",
    "@storybook/addon-docs": "^8.6.12",
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/addon-links": "^8.6.12",
    "@storybook/addon-styling-webpack": "^1.0.1",
    "@storybook/addon-webpack5-compiler-swc": "^3.0.0",
    "@storybook/blocks": "^8.6.12",
    "@storybook/manager-api": "^8.6.12",
    "@storybook/preview-api": "^8.6.12",
    "@storybook/react": "^8.6.12",
    "@storybook/react-webpack5": "^8.6.12",
    "@storybook/theming": "^8.6.12",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "@testing-library/react": "^16.2.0",
    "@wordpress/jest-preset-default": "^8.0.1",
    "@yoast/browserslist-config": "^1.2.5",
    "@yoast/eslint-config": "^8.4.0",
    "@yoast/jest-preset": "^1.0.1",
    "@yoast/postcss-preset": "^1.2.1",
    "@yoast/tailwindcss-preset": "^2.6.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.10.0",
    "eslint": "^9.16.0",
    "globals": "^15.12.0",
    "jest": "^27.5.1",
    "postcss": "^8.4.19",
    "postcss-loader": "^7.3.4",
    "storybook": "^8.6.12",
    "style-loader": "^3.3.4",
    "tailwindcss": "^3.4.16"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.8",
    "@heroicons/react": "^1.0.6",
    "@reduxjs/toolkit": "^1.8.3",
    "classnames": "^2.3.2",
    "lodash": "^4.17.21",
    "prop-types": "^15.8.1",
    "react-animate-height": "^3.1.0",
    "react-error-boundary": "^3.1.4"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  }
}
