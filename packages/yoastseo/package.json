{
  "name": "yoastseo",
  "description": "Yoast client-side content analysis",
  "homepage": "https://github.com/Yoast/",
  "keywords": [
    "Yoast",
    "SEO",
    "readability",
    "inclusive language"
  ],
  "main": "build/index.js",
  "module": "./esm/index.js",
  "types": "types",
  "license": "GPL-3.0",
  "version": "3.6.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yoast/wordpress-seo.git",
    "directory": "packages/yoastseo"
  },
  "files": [
    "build",
    "esm",
    "!*.map",
    "images",
    "researcher",
    "contract",
    "docs/**/*.md"
  ],
  "sideEffects": [
    "./build/helpers/shortlinker/singleton.js",
    "./esm/helpers/shortlinker/singleton.js"
  ],
  "scripts": {
    "build": "yarn clean && yarn build:js && yarn build:esm && yarn build:types",
    "build:js": "babel src --copy-files --source-maps --out-dir build",
    "build:esm": "yarn build:esm:package && babel src --env-name esm --copy-files --source-maps --out-dir esm",
    "build:esm:package": "mkdir -p esm && echo '{ \"type\": \"module\" }' > esm/package.json",
    "build:types": "tsc",
    "clean": "rm -rf build esm types",
    "pretest": "grunt get-premium-configuration",
    "export:inclusive-language": "jest exportInclusiveLanguage",
    "test": "jest",
    "lint": "eslint . --max-warnings 16",
    "watch": "yarn clean && (yarn watch:js & yarn watch:esm)",
    "watch:js": "yarn build:js --watch",
    "watch:esm": "yarn build:esm --watch",
    "watch:types": "tsc --watch"
  },
  "engines": {
    "node": ">=8.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.9",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@yoast/browserslist-config": "^1.2.5",
    "@yoast/eslint-config": "^8.3.0",
    "blob-polyfill": "^7.0.20220408",
    "console.table": "^0.10.0",
    "eslint": "^9.20.1",
    "globals": "^15.12.0",
    "grunt": "^1.6.1",
    "grunt-shell": "^4.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-html-loader": "^1.0.0",
    "js-yaml": "^4.1.0",
    "load-grunt-config": "^1.0.0",
    "typescript": "^5.6.3"
  },
  "bugs": {
    "url": "https://github.com/Yoast/wordpress-seo/issues"
  },
  "dependencies": {
    "@wordpress/i18n": "^5.8.2",
    "@yoast/feature-flag": "^0.6.0-alpha.2",
    "htmlparser2": "^3.9.2",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "loglevel": "^1.9.2",
    "parse5": "^8.0.0",
    "tiny-segmenter": "^0.2.0",
    "tokenizer2": "^2.0.1",
    "zod": "^4.6.6"
  },
  "yoast": {
    "premiumConfiguration": ""
  }
}
