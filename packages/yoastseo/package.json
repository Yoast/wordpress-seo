{
  "name": "yoastseo",
  "description": "Yoast client-side content analysis",
  "homepage": "https://github.com/Yoast/",
  "keywords": [
    "Yoast",
    "SEO",
    "readability",
    "inclusive language"
  ],
  "main": "build/index.js",
  "types": "types",
  "license": "GPL-3.0",
  "version": "3.6.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yoast/wordpress-seo.git",
    "directory": "packages/yoastseo"
  },
  "files": [
    "build",
    "!*.map",
    "images",
    "researcher",
    "contract",
    "docs/**/*.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "yarn clean && yarn build:js && yarn build:types",
    "build:js": "babel src --copy-files --source-maps --out-dir build",
    "build:types": "tsc",
    "clean": "rm -rf build types",
    "pretest": "grunt get-premium-configuration",
    "export:inclusive-language": "jest exportInclusiveLanguage",
    "test": "jest",
    "lint": "eslint . --max-warnings 16",
    "watch": "yarn clean && yarn watch:js",
    "watch:js": "yarn build:js --watch",
    "watch:types": "tsc --watch"
  },
  "engines": {
    "node": ">=8.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@yoast/browserslist-config": "^1.2.5",
    "@yoast/eslint-config": "^8.4.0",
    "blob-polyfill": "^9.0.20240710",
    "console.table": "^0.10.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "grunt": "^1.6.3",
    "grunt-shell": "^4.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-html-loader": "^1.0.0",
    "js-yaml": "^5.5.0",
    "load-grunt-config": "^1.0.0",
    "typescript": "^5.9.3"
  },
  "bugs": {
    "url": "https://github.com/Yoast/wordpress-seo/issues"
  },
  "dependencies": {
    "@wordpress/i18n": "^5.8.2",
    "@yoast/feature-flag": "^0.6.0-alpha.2",
    "htmlparser2": "^3.9.2",
    "lodash": "^4.17.21",
    "loglevel": "^1.9.2",
    "parse5": "^8.1.1",
    "tiny-segmenter": "^0.2.0",
    "tokenizer2": "^2.0.1",
    "zod": "^4.6.7"
  },
  "yoast": {
    "premiumConfiguration": ""
  }
}
